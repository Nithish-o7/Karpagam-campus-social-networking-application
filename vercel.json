{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "kce-connect-frontend",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "env": {
    "VITE_API_URL": "@kce_api_url",
    "VITE_FIREBASE_API_KEY": "@kce_firebase_api_key",
    "VITE_FIREBASE_AUTH_DOMAIN": "@kce_firebase_auth_domain",
    "VITE_FIREBASE_PROJECT_ID": "@kce_firebase_project_id",
    "VITE_FIREBASE_STORAGE_BUCKET": "@kce_firebase_storage_bucket",
    "VITE_FIREBASE_MESSAGING_SENDER_ID": "@kce_firebase_messaging_sender_id",
    "VITE_FIREBASE_APP_ID": "@kce_firebase_app_id",
    "VITE_FIREBASE_MEASUREMENT_ID": "@kce_firebase_measurement_id"
  }
}
