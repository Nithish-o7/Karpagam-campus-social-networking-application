# ============================================================
# KCE Connect — Middleware Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend Origin (for CORS) ──────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── JWT Secret (use a long, random 32+ char string) ─────────
JWT_SECRET=your_super_secret_jwt_key_here

# ============================================================
# PostgreSQL — DATABASE_URL
# ============================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# ► Local development (no SSL):
#   DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/kce_connect"
#
# ► Remote / Neon / Supabase (requires ?sslmode=require):
#   DATABASE_URL="postgresql://user:pass@db.xxxx.supabase.co:5432/postgres?sslmode=require"
#
# ► Prisma Cloud / Accelerate:
#   DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"
#
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/kce_connect"

# ============================================================
# ServiceNow Developer Instance Credentials
# Used by the secure proxy — never expose to client.
# ============================================================
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your_servicenow_admin_username
SERVICENOW_PASSWORD=your_servicenow_admin_password

# ServiceNow Custom Table for KCE Requests
SERVICENOW_TABLE=x_kce_campus_request
